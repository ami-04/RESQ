# Copy to .env (never commit .env). Real values only on the station laptop.
RESQ_TEAM_TOKEN=put-your-team-token-here
RESQ_API_BASE=https://hackathon.ortsbereit.de
# live = the competition log; rehearsal = practice (uploads blocked)
RESQ_MODE=live
RESQ_DATA_DIR=data/live
RESQ_TIMEZONE=Europe/Berlin
# Replacement device only: start walk-in numbers higher to avoid duplicate IDs (e.g. 501)
RESQ_WALKIN_START=1
RESQ_CONSENT_VERSION=1.0
# 127.0.0.1 = operator screen only. 0.0.0.0 = also serve /phone to phones on the station Wi-Fi
# (operator API stays restricted to the station laptop itself).
RESQ_HOST=127.0.0.1
RESQ_PORT=5000
